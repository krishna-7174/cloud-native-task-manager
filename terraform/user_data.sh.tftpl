#!/bin/bash
set -euo pipefail

dnf install -y docker awscli
systemctl enable --now docker

MONGO_URI="$(aws ssm get-parameter \
  --name "${mongo_parameter_name}" \
  --region "${region}" \
  --with-decryption \
  --query "Parameter.Value" \
  --output text)"

aws ecr get-login-password --region "${region}" | \
  docker login \
    --username AWS \
    --password-stdin \
    "${account_id}.dkr.ecr.${region}.amazonaws.com"

docker network create task-manager || true

docker pull "${account_id}.dkr.ecr.${region}.amazonaws.com/cloud-native-task-manager/backend:latest"
docker pull "${account_id}.dkr.ecr.${region}.amazonaws.com/cloud-native-task-manager/frontend:latest"

docker rm -f task-manager-backend task-manager-frontend || true

docker run -d \
  --name task-manager-backend \
  --restart unless-stopped \
  --network task-manager \
  -e "MONGO_URI=$${MONGO_URI}" \
  -e "PORT=5000" \
  "${account_id}.dkr.ecr.${region}.amazonaws.com/cloud-native-task-manager/backend:latest"

docker run -d \
  --name task-manager-frontend \
  --restart unless-stopped \
  --network task-manager \
  -p 80:80 \
  -e "BACKEND_URL=task-manager-backend:5000" \
  "${account_id}.dkr.ecr.${region}.amazonaws.com/cloud-native-task-manager/frontend:latest"